# Copy to `.env` for local dev OR paste these as Variables in Railway.
# Env vars OVERRIDE matching keys in config.json — production should rely
# entirely on env vars (config.json should hold only non-secret defaults).

# ─── REQUIRED ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...                # https://console.anthropic.com
API_AUTH_TOKEN=replace-with-a-long-random-string  # Bubble must send Bearer <this>

# ─── AIRTABLE (required only if you want auto-upload) ────────────
AIRTABLE_API_TOKEN=pat...                         # Personal Access Token
AIRTABLE_BASE_ID=app...
AIRTABLE_BS_PL_TABLE_ID=tbl...
AIRTABLE_USER_TABLE_ID=tbl...
AIRTABLE_COMPANY_TABLE_ID=tbl...
AIRTABLE_USER_EMAIL=you@yourdomain.com

# ─── OPTIONAL ────────────────────────────────────────────────────
OPENAI_API_KEY=                                   # Only if mapper_mode=v2_llm
CLAUDE_MODEL=claude-sonnet-4-6                    # Override per-deploy if needed
MAPPER_MODE=claude                                # claude | v2_llm | hybrid | rules_only
STANDALONE_ONLY=true                              # false to map both variants
AIRTABLE_AUTO_UPLOAD=false                        # true = auto-push every job
AUTO_OBSERVATIONS=true                            # false = manual obs only

# ─── PRODUCTION INFRA ────────────────────────────────────────────
PORT=5000                                         # Railway sets this automatically
DATA_DIR=/data                                    # Mount Railway volume here for
                                                  # persistent uploads/output/chroma_db
CORS_ORIGINS=https://yourapp.bubbleapps.io        # Bubble origin; '*' for any
